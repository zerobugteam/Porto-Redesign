---
---
<header class="site-header" id="top">
  <div class="container header-inner">
    <a href="#top" class="brand" aria-label="ZeroBug Team Home">
      <img src="/logo.png" alt="ZeroBug Logo" class="brand-logo-img" />
      <span class="brand-name">Zero<span>Bug</span></span>
    </a>

    <nav class="main-nav" id="main-nav">
      <a href="#proyek">Proyek</a>
      <a href="#layanan">Kapabilitas</a>
      <a href="#teknologi">Teknologi</a>
      <a href="#proses">Metodologi</a>
      <a href="#filosofi">Keunggulan</a>
    </nav>

    <div class="header-actions">
      <button class="icon-btn" id="theme-toggle" aria-label="Ganti tema terang/gelap" type="button">
        <svg class="icon icon-show-light" aria-hidden="true"><use href="#icon-sun"/></svg>
        <svg class="icon icon-show-dark" aria-hidden="true"><use href="#icon-theme"/></svg>
      </button>
      <a class="btn btn-primary btn-sm nav-cta-btn" href="https://wa.me/6281229523471" target="_blank" rel="noopener">
        <span>Mulai Diskusi</span>
        <svg class="icon" aria-hidden="true"><use href="#icon-arrow-right"/></svg>
      </a>
      <button class="icon-btn nav-toggle" id="nav-toggle" aria-label="Buka menu navigasi" aria-expanded="false" type="button">
        <svg class="icon icon-menu-open" aria-hidden="true"><use href="#icon-menu"/></svg>
        <svg class="icon icon-menu-close" aria-hidden="true"><use href="#icon-x"/></svg>
      </button>
    </div>
  </div>
</header>

