---
---
<section class="hero">
  <div class="container">
    <div class="reveal">
      <div class="hero-pill">
        <span class="pulse-dot" aria-hidden="true"></span>
        <span>Engineering Hub • Tersedia untuk Proyek Baru</span>
      </div>
      
      <h1 class="hero-headline">
        Kami Merancang &amp; Membangun <span class="text-gradient">Produk Digital Berkelas Dunia.</span>
      </h1>
      
      <p class="hero-sub">
        ZeroBug Team adalah software design &amp; engineering agency yang mentransformasi ide kompleks menjadi aplikasi Web, Mobile, dan Sistem IoT yang tangguh, teruji, dan siap bersaing di pasar.
      </p>

      <div class="hero-actions">
        <a class="btn btn-primary btn-lg" href="https://wa.me/6281229523471" target="_blank" rel="noopener">
          Diskusikan Proyek Anda
          <svg class="icon" aria-hidden="true"><use href="#icon-arrow-right"/></svg>
        </a>
        <a class="btn btn-secondary btn-lg" href="#proyek">
          Eksplorasi Karya Kami
        </a>
      </div>
    </div>

    <!-- STRV Signature Metrics Bar -->
    <div class="metrics-bar reveal">
      <div class="metric-item">
        <span class="metric-value">100%</span>
        <span class="metric-label">Source Code Milik Klien</span>
      </div>
      <div class="metric-item">
        <span class="metric-value">3 Core</span>
        <span class="metric-label">Domain: Web, Mobile, &amp; IoT</span>
      </div>
      <div class="metric-item">
        <span class="metric-value">0-Bug</span>
        <span class="metric-label">Komitmen Uji &amp; Kualitas</span>
      </div>
      <div class="metric-item">
        <span class="metric-value">End-to-End</span>
        <span class="metric-label">Dari Konsep hingga Deploy</span>
      </div>
    </div>
  </div>
</section>

