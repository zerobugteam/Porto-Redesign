---
---
<section class="tech" id="teknologi">
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow">// Fondasi Teknologi</span>
      <h2 class="section-title">Teknologi Teruji di Lapangan</h2>
      <p class="section-desc">Kami memilih tools yang stabil, didukung komunitas besar, dan menjamin skalabilitas jangka panjang.</p>
    </div>

    <div class="tech-container reveal">
      <div class="tech-grid">
        
        <div class="tech-column">
          <h4>
            <svg class="icon" aria-hidden="true"><use href="#icon-layers"/></svg>
            Backend &amp; Cloud
          </h4>
          <div class="tech-chips">
            <span class="tech-chip">Laravel</span>
            <span class="tech-chip">PHP 8+</span>
            <span class="tech-chip">MySQL</span>
            <span class="tech-chip">PostgreSQL</span>
            <span class="tech-chip">REST APIs</span>
            <span class="tech-chip">Docker</span>
          </div>
        </div>

        <div class="tech-column">
          <h4>
            <svg class="icon" aria-hidden="true"><use href="#icon-smartphone"/></svg>
            Mobile &amp; Frontend
          </h4>
          <div class="tech-chips">
            <span class="tech-chip">Flutter</span>
            <span class="tech-chip">Dart</span>
            <span class="tech-chip">Android SDK</span>
            <span class="tech-chip">Firebase</span>
            <span class="tech-chip">Tailwind CSS</span>
            <span class="tech-chip">Astro</span>
          </div>
        </div>

        <div class="tech-column">
          <h4>
            <svg class="icon" aria-hidden="true"><use href="#icon-cpu"/></svg>
            Hardware &amp; IoT
          </h4>
          <div class="tech-chips">
            <span class="tech-chip">ESP32</span>
            <span class="tech-chip">MQTT Protocol</span>
            <span class="tech-chip">RFID / NFC</span>
            <span class="tech-chip">Sensor Modules</span>
            <span class="tech-chip">Embedded C++</span>
            <span class="tech-chip">WebSockets</span>
          </div>
        </div>

      </div>
    </div>
  </div>
</section>

