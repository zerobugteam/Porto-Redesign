---
import { techLogos } from '../data/techLogos.js';

// Duplikasi untuk animasi infinite marquee yang mulus tersambung
const marqueeList = [...techLogos, ...techLogos];
---

<section class="tech-marquee-section" id="teknologi">
  <div class="container">
    <div class="section-head reveal" style="text-align: center; max-width: 680px; margin: 0 auto 40px;">
      <span class="eyebrow">// TEKNOLOGI YANG KAMI GUNAKAN</span>
      <h2 class="section-title">Alat &amp; Teknologi Terpercaya</h2>
      <p class="section-desc" style="margin: 0 auto;">
        Kami memilih teknologi yang sudah terbukti cepat, aman, dan stabil di dunia nyata agar sistem atau aplikasi Anda berjalan lancar tanpa kendala.
      </p>
    </div>

    <!-- Pure Logo Marquee: Murni Logo Asli Tanpa Card Kotak, Tanpa Teks Penjelasan -->
    <div class="marquee-container reveal">
      <div class="pure-logo-track">
        {marqueeList.map((tech) => (
          <div class="pure-logo-item" title={tech.name} aria-label={tech.name}>
            <div set:html={tech.svg} />
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
